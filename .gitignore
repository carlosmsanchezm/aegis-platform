# Tool caches (match anywhere; entire dirs)
**/.bufcache/
**/.gocache/
**/.gomodcache/

# Also catch top-level variants just in case
/.bufcache/
/.gocache/
/.gomodcache/

# Local tooling binaries
/bin/
/.tools/
/.tools/**

# Editor / OS files
.DS_Store
.idea/
.vscode/

# Node.js / Yarn / Frontend
**/node_modules/
**/dist/
**/dist-types/
**/build/
**/.next/
**/.turbo/
**/.cache/
**/.parcel-cache/
**/.storybook/

# Package manager lockfiles (optional – keep if you want reproducibility)
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Test coverage
coverage/
.nyc_output/

# Environment files (only if you don’t want them committed)
.env
.env.local
.env.*.local

# Misc frontend artifacts
*.tsbuildinfo
agents/strands
docs
out
servers
.aegis
policy
scripts
third_party
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
agents/claude/
plans/
backups/
