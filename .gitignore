# Tool caches (match anywhere; entire dirs)
**/.bufcache/
**/.gocache/
**/.gomodcache/

# Also catch top-level variants just in case
/.bufcache/
/.gocache/
/.gomodcache/

# Local tooling binaries
/bin/
/.tools/
/.tools/**

# Editor / OS files
.DS_Store
.idea/
.vscode/

# Node.js / Yarn / Frontend
**/node_modules/
**/dist/
**/dist-types/
**/build/
**/.next/
**/.turbo/
**/.cache/
**/.parcel-cache/
**/.storybook/

# Python
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so

# Package manager lockfiles (optional – keep if you want reproducibility)
# yarn.lock (keep project-specific ones like aegis-platform/yarn.lock)
/yarn.lock
# package-lock.json
# pnpm-lock.yaml

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Test coverage
coverage/
.nyc_output/

# Environment files (only if you don’t want them committed)
.env
.env.local
.env.*.local

# Misc frontend artifacts
*.tsbuildinfo
out
.aegis
policy
third_party
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
plans/
backups/
CREDENTIALS-CHEATSHEET.md
agents/__init__.py
agents/__pycache__

# Helm auto-generated values files
charts/aegis-services/values-cloud-generated.yaml
charts/aegis-spoke/values-cloud-generated.yaml

# Compliance evidence (stored in separate vault)
compliance-evidence/
