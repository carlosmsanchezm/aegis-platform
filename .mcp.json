{
  "mcpServers": {
    "aegis": {
      "command": "uv",
      "args": [
        "run",
        "--env-file",
        ".env",
        "--python",
        "3.11",
        "--with",
        "mcp",
        "servers/aegis/aegis_mcp_server.py"
      ]
    },
    "jira-local": {
      "command": "uv",
      "args": [
        "run",
        "--env-file",
        ".env",
        "--python",
        "3.11",
        "--with",
        "mcp",
        "--with",
        "httpx",
        "servers/jira/jira_mcp_server.py"
      ]
    },
    "github": {
      "command": "uv",
      "args": [
        "run",
        "--env-file",
        ".env",
        "--python",
        "3.11",
        "--with",
        "mcp",
        "--with",
        "httpx",
        "servers/github_actions/github_actions_mcp_server.py"
      ]
    }
  }
}
