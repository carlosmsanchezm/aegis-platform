     1 keycloak:
     2   enabled: true
     3   forceRender: true
     4   createNamespace: false
     5   operator:
     6     imagePullSecrets:
     7       - name: redhat-pull-secret
     8   imagePullSecrets:
     9     - name: redhat-pull-secret
    10   http:
    11     httpEnabled: false
    12   admin:
    13     secret:
    14       create: true
    15       name: keycloak-admin-secret
    16       username: admin
    17       password: REDACTED_KEYCLOAK_ADMIN_PASSWORD
    18   database:
    19     secret:
    20       create: true
    21       name: keycloak-db-secret
    22       username: keycloak
    23       password: REDACTED_KEYCLOAK_DB_PASSWORD
    24   realm:
    25     enabled: true
    26     name: aegis
    27     displayName: Aegis
    28     client:
    29       id: backstage
    30       name: Backstage
    31       redirectUris:
    32         - http://localhost:7008/*
    33         - https://backstage.localtest.me/*
    34       webOrigins:
    35         - http://localhost:3000
    36         - https://backstage.localtest.me
    37       secret:
    38         create: true
    39         name: keycloak-backstage-client-secret
    40         value: local-backstage-client-secret
    41         placeholder: BACKSTAGE_CLIENT_SECRET
    42     requiredActions:
    43       - alias: CONFIGURE_TOTP
    44         name: Configure OTP
    45         providerId: CONFIGURE_TOTP
    46         defaultAction: true
    47         enabled: true
