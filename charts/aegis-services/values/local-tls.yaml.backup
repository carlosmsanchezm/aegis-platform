# Local TLS overlay for aegis-services
# Apply alongside local.yaml when testing TLS locally on Docker Desktop
#
# Usage:
#   helm upgrade --install aegis-services charts/aegis-services \
#     -f charts/aegis-services/values/common.yaml \
#     -f charts/aegis-services/values/local.yaml \
#     -f charts/aegis-services/values/local-tls.yaml \
#     --namespace aegis-system --create-namespace

ingress-nginx:
  controller:
    admissionWebhooks:
      timeoutSeconds: 30

backstage:
  caBundle:
    create: true

platformApi:
  ingress:
    enabled: true
    className: "ingress-nginx"
    annotations:
      nginx.ingress.kubernetes.io/backend-protocol: "GRPCS"
      nginx.ingress.kubernetes.io/proxy-ssl-secret: "aegis-system/aegis-services-platform-api-tls"
      nginx.ingress.kubernetes.io/proxy-ssl-verify: "off"
      nginx.ingress.kubernetes.io/proxy-ssl-server-name: "platform-api-grpc.localtest.me"
      nginx.ingress.kubernetes.io/ssl-protocols: "TLSv1.2 TLSv1.3"
      nginx.ingress.kubernetes.io/ssl-ciphers: "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384:TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256:TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384:TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
      nginx.ingress.kubernetes.io/ssl-prefer-server-ciphers: "true"
    tls:
      - secretName: aegis-services-platform-api-tls
        hosts:
          - platform-api-grpc.localtest.me
    hosts:
      - host: platform-api-grpc.localtest.me
        paths:
          - path: /
            pathType: Prefix
            service: grpc
  tls:
    enabled: true
    serveGrpc: true
    # Local testing certificate chain: leaf served to clients followed by the embedded root CA.
    # To rotate, create a root CA and sign a new leaf, e.g.:
    #   openssl req -x509 -nodes -newkey rsa:4096 -days 3650 \
    #     -keyout /tmp/aegis-root.key -out /tmp/aegis-root.pem \
    #     -subj "/O=Aegis Dev/CN=Aegis Local Root CA" \
    #     -addext "basicConstraints=critical,CA:TRUE,pathlen:1" \
    #     -addext "keyUsage=critical,keyCertSign,cRLSign"
    #   openssl req -new -nodes -newkey rsa:2048 \
    #     -keyout /tmp/platform-api.key -out /tmp/platform-api.csr \
    #     -subj "/O=Aegis Dev/CN=platform-api.localtest.me" \
    #     -addext "subjectAltName=DNS:platform-api.localtest.me,DNS:platform-api-grpc.localtest.me,DNS:proxy.localtest.me" \
    #     -addext "keyUsage=critical,digitalSignature,keyEncipherment" \
    #     -addext "extendedKeyUsage=serverAuth"
    #   openssl x509 -req -in /tmp/platform-api.csr -CA /tmp/aegis-root.pem -CAkey /tmp/aegis-root.key -CAcreateserial \
    #     -out /tmp/platform-api.pem -days 825 -sha256 \
    #     -extfile <(printf \"subjectAltName=DNS:platform-api.localtest.me,DNS:platform-api-grpc.localtest.me,DNS:proxy.localtest.me\\nkeyUsage=critical,digitalSignature,keyEncipherment\\nextendedKeyUsage=serverAuth\")
    cert: |
      -----BEGIN CERTIFICATE-----
      MIIEbzCCAlegAwIBAgIJAO7PYN9VNKhFMA0GCSqGSIb3DQEBCwUAMDIxEjAQBgNV
      BAoMCUFlZ2lzIERldjEcMBoGA1UEAwwTQWVnaXMgTG9jYWwgUm9vdCBDQTAeFw0y
