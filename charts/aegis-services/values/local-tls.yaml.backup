  env:
    AEGIS_PROXY_BASE_URL: "https://proxy.localtest.me"
  env:
    OIDC_ISSUER_URL: "https://aegis-services-keycloak-service.keycloak.svc.cluster.local:8443/realms/aegis"
  httpIngress:
    enabled: true
    className: "ingress-nginx"
    annotations:
      nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
      nginx.ingress.kubernetes.io/ssl-redirect: "true"
    tls:
      - secretName: aegis-services-platform-api-tls
        hosts:
          - platform-api.localtest.me
    hosts:
      - host: platform-api.localtest.me
        paths:
          - path: /
            pathType: Prefix
            service: http

