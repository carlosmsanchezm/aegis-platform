## REFERENCE: vault-csi-provider Iron Bank Dockerfile
## Source: repo1.dso.mil/dsop/hashicorp/vault-csi-provider
## Pattern: Go binary compiled in Iron Bank golang builder, deployed on distroless
## This is the pattern closest to Aegis's proxy and k8s-agent

ARG BASE_REGISTRY=registry1.dso.mil
ARG BASE_IMAGE=ironbank/google/distroless/static
ARG BASE_TAG=nonroot

FROM registry1.dso.mil/ironbank/google/golang/ubi9/golang-1.22:1.22.12 as build

COPY vault-csi-provider.tar.gz /

RUN mkdir -p /go/src/github.com/hashicorp/vault-csi-provider && \
    tar -zxf /vault-csi-provider.tar.gz -C /go/src/github.com/hashicorp/vault-csi-provider --strip-components=1

WORKDIR /go/src/github.com/hashicorp/vault-csi-provider

RUN GOCACHE=/tmp CGO_ENABLED=0 go build -o vault-csi-provider

FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

COPY --from=build --chown=root:root /go/src/github.com/hashicorp/vault-csi-provider/vault-csi-provider /bin/vault-csi-provider

USER 65534

HEALTHCHECK NONE

ENTRYPOINT ["vault-csi-provider"]
