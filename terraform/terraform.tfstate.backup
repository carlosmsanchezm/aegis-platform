    "helm_values_aegis_services": {
      "value": "# Auto-generated from Terraform - aegis-services (Control Plane / Hub)\n# Cluster: aegis-spoke-prod\n# Region: us-east-1\n# Generated: 2025-10-03T09:09:20Z\n\nplatformApi:\n  image:\n    repository: 567751785679.dkr.ecr.us-east-1.amazonaws.com/aegis/platform-api\n    tag: \"latest\"  # TODO: Use specific version tags\n\n  env:\n    DB_HOST: \"aegis-spoke-prod-db.cepmyey24yl0.us-east-1.rds.amazonaws.com\"\n    DB_PORT: \"5432\"\n    DB_NAME: \"aegis\"\n    DB_USER: \"aegis_api\"\n    DB_SSLMODE: \"require\"\n    AEGIS_PROXY_BASE_URL: \"https://proxy.yourdomain.com\"  # TODO: Update domain\n    AEGIS_PROXY_EXPECTED_AUDIENCE: \"aegis-proxy\"\n    AEGIS_STORE_BACKEND: \"postgres\"\n\n  # Secrets - retrieve with: terraform output -raw db_password_secret_value\n  # kubectl create secret generic aegis-platform-secrets \\\n  #   --from-literal=db-password=\"$(terraform output -raw db_password_secret_value)\" \\\n  #   --from-literal=proxy-jwt-secret=\"$(terraform output -raw jwt_secret_value)\"\n\n  ingress:\n    enabled: true\n    hosts:\n      - host: platform-api.yourdomain.com  # TODO: Update domain\n        paths:\n          - path: /\n            pathType: Prefix\n            service: \"http\"\n      - host: platform-api-grpc.yourdomain.com  # TODO: Update domain\n        paths:\n          - path: /\n            pathType: Prefix\n            service: \"grpc\"\n\nproxy:\n  image:\n    repository: 567751785679.dkr.ecr.us-east-1.amazonaws.com/aegis/proxy\n    tag: \"latest\"  # TODO: Use specific version tags\n\n  publicHost: \"proxy.yourdomain.com\"  # TODO: Update domain\n\n  ingress:\n    enabled: true\n    hosts:\n      - host: proxy.yourdomain.com  # TODO: Update domain\n        paths:\n          - path: /proxy\n            pathType: Prefix\n",
      "type": "string",
      "sensitive": true
    },
    "helm_values_aegis_spoke": {
      "value": "# Auto-generated from Terraform - aegis-spoke (Workload Cluster)\n# Cluster: aegis-spoke-prod\n# Region: us-east-1\n# Generated: 2025-10-03T09:09:19Z\n\nk8sAgent:\n  image:\n    repository: 567751785679.dkr.ecr.us-east-1.amazonaws.com/aegis/k8s-agent\n    tag: \"latest\"  # TODO: Use specific version tags\n\n  env:\n    AEGIS_CP_GRPC: \"aegis-platform-api.aegis-system.svc.cluster.local:8081\"\n    AEGIS_PROXY_INGRESS_HOST: \"proxy.yourdomain.com\"  # TODO: Update domain\n    AEGIS_CLUSTER_ID: \"aws-us-east-1-prod\"\n\nproxy:\n  enabled: false  # Use aegis-services proxy for hub/spoke architecture\n",
