# Example Terraform variables file
# Copy this to terraform.tfvars and adjust values as needed

# AWS Configuration
aws_region  = "us-east-1"
aws_profile = "myclaude"  # Your AWS profile

# Environment
environment = "prod"  # or "dev", "staging"

# EKS Configuration
cluster_name_prefix = "aegis-spoke"
cluster_version    = "1.33"

# Instance types and capacity
cpu_instance_type    = "t3.medium"
gpu_instance_type    = "g4dn.xlarge"
cpu_desired_capacity = 1
gpu_desired_capacity = 0  # Start with 0 for cost savings
gpu_max_capacity     = 2
use_spot_instances   = true  # Cost optimization

# RDS Configuration
db_instance_class         = "db.t3.micro"    # Start small, can upgrade
db_allocated_storage      = 20
db_max_allocated_storage  = 100
db_postgres_version       = "15.4"
db_backup_retention       = 7
db_skip_final_snapshot    = false  # Keep backups in prod

# ECR Repositories
ecr_repositories = [
  "aegis/k8s-agent",
  "aegis/proxy",
  "aegis/platform-api"
]

# Create secrets in AWS Secrets Manager
create_secrets = true

# VPC Configuration (optional - uses sensible defaults)
# vpc_cidr = "10.0.0.0/16"
# availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]